{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["examples/**"],
  "ignore": ["**/*benchmark*", "**/benchmarks/**", "tests/e2e/**"],
  "workspaces": {
    "packages/table-core": {
      "ignore": ["**/tests/**"]
    },
    "packages/match-sorter-utils": {
      "ignoreDependencies": ["remove-accents"]
    },
    "packages/ember-table": {
      "entry": [
        "src/index.ts!",
        "babel.publish.config.cjs",
        "testem.cjs",
        "tests/test-helper.ts"
      ],
      "ignoreDependencies": [
        "@babel/runtime",
        "@ember/library-tsconfig",
        "@ember/routing",
        "@ember/test-waiters",
        "@embroider/shared-internals",
        "@glimmer/tracking",
        "@glimmer/validator",
        "@glint/tsserver-plugin",
        "ember-page-title"
      ]
    },
    "packages/angular-table": {
      "entry": [
        "src/index.ts!",
        "static-functions/index.ts!",
        "experimental-worker-plugin/index.ts!"
      ]
    },
    "packages/svelte-table": {
      "entry": [
        "src/index.ts!",
        "src/static-functions.ts!",
        "src/flex-render.ts!"
      ]
    }
  }
}
