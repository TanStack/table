{
  "name": "tanstack-react-table-example-realtime-trading",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:profile": "vite build --mode profile",
    "serve": "vite preview",
    "lint": "eslint ./src",
    "test:types": "tsc --noEmit",
    "test:e2e": "PLAYWRIGHT_VITE_MODE=profile PLAYWRIGHT_TEST_DIR=$PWD/tests/e2e playwright test --config ../../../playwright.config.ts"
  },
  "nx": {
    "targets": {
      "test:e2e": {
        "parallelism": false
      }
    }
  },
  "dependencies": {
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "~1.2.8",
    "@rolldown/plugin-babel": "^0.2.4",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0"
  }
}
