{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": false, "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "experimentalDecorators": true, "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests/e2e", "vite.config.ts"]
}
